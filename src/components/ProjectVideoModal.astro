---
interface Props {
  embedUrl: string;
  title: string;
}

const { embedUrl, title } = Astro.props;
---

<div class="project-video-modal" aria-hidden="true" role="dialog" aria-label={`${title} video`}>
  <button class="project-video-close" type="button" aria-label="Close video">←</button>
  <iframe
    class="project-video-modal-frame"
    data-src={embedUrl}
    title={`${title} fullscreen video`}
    allow="autoplay; fullscreen; picture-in-picture"
    allowfullscreen
  ></iframe>
</div>

<style>
  .project-video-modal {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: none;
    place-items: center;
    padding: calc(var(--spacer) * 2);
    background-color: rgb(0 0 0 / 92%);
  }

  .project-video-modal[data-open="true"] {
    display: grid;
  }

  .project-video-modal-frame {
    width: min(100%, 160vh);
    height: min(100%, 56.25vw);
    max-height: calc(100vh - var(--spacer) * 4);
    border: 0;
    background-color: black;
  }

  .project-video-close {
    position: fixed;
    top: var(--spacer);
    right: var(--spacer);
    z-index: 51;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    color: var(--clr-bg);
    font-size: 2rem;
    font-weight: 300;
    line-height: 1;
    background-color: rgb(30 30 30 / 70%);
  }

  .project-video-close:hover {
    color: var(--clr-text);
    background-color: var(--clr-lines);
  }
</style>

<script>
  const videoOpen = document.querySelector<HTMLButtonElement>(".project-video-open");
  const videoModal = document.querySelector<HTMLElement>(".project-video-modal");
  const videoClose = document.querySelector<HTMLButtonElement>(".project-video-close");
  const videoModalFrame = document.querySelector<HTMLIFrameElement>(".project-video-modal-frame");
  const info = document.querySelector<HTMLElement>(".info");

  const openVideoModal = () => {
    if (!videoModal || !videoModalFrame) return;

    videoModal.dataset.open = "true";
    videoModal.setAttribute("aria-hidden", "false");
    videoModalFrame.src = videoModalFrame.dataset.src ?? "";
    document.documentElement.style.overflow = "hidden";
    videoClose?.focus();
  };

  const closeVideoModal = () => {
    if (!videoModal || !videoModalFrame) return;

    videoModal.dataset.open = "false";
    videoModal.setAttribute("aria-hidden", "true");
    videoModalFrame.src = "";
    if (!info?.classList.contains("info-show")) {
      document.documentElement.style.overflow = "";
    }
    videoOpen?.focus();
  };

  videoOpen?.addEventListener("click", openVideoModal);
  videoClose?.addEventListener("click", closeVideoModal);
  videoModal?.addEventListener("click", (event) => {
    if (event.target === videoModal) closeVideoModal();
  });
  window.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && videoModal?.dataset.open === "true") {
      closeVideoModal();
    }
  });
</script>
