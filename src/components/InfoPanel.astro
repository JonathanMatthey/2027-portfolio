---
import Picture from "./Picture.astro";
---

<aside class="info" id="info-panel" aria-hidden="true">
  <section class="info-entry info-about">
    <div class="info-about-text">
      <Picture
        class="info-avatar"
        src="/img/projects/jonathan-matthey-avatar.webp"
        alt="Jonathan Matthey"
      />
      <p>
        Jonathan works across photography, film, and performance, with a focus
        on the human form and black-and-white portraiture.
      </p>
      <p>His work is minimal, direct, grounded in authenticity.</p>
      <p>
        He is currently developing an exhibition on Barcelona's chatarreros.
        Working with both digital and analog processes, across Paris, Berlin,
        and US.
      </p>
    </div>
  </section>

  <div class="info-wrapper">
    <section class="info-entry info-contact">
      <a href="mailto:studio@jonathanmatthey.com">studio@jonathanmatthey.com</a>
    </section>

    <section class="info-entry info-cv">
      <h3>Solo Exhibitions</h3>
      <p>2026</p>
      <ul>
        <li>
          <p><em>Absordo</em></p>
          <p>Galeria Alegria</p>
        </li>
      </ul>
      <p>2025</p>
      <ul>
        <li>
          <p><em>Monocromo</em></p>
          <p>Studio Pintor</p>
        </li>
      </ul>

      <h3>Performance</h3>
      <p>2026</p>
      <ul>
        <li>
          <p><em>SYNC</em></p>
          <p>Galeria Alegria</p>
        </li>
      </ul>

      <h3>Education</h3>
      <p>2021</p>
      <ul>
        <li><p>Barcelona Academy of Art</p></li>
      </ul>
      <p>2007</p>
      <ul>
        <li><p>Glasgow School of Art</p></li>
      </ul>
    </section>
  </div>
</aside>

<style>
  .info {
    position: fixed;
    top: var(--header-height, 49px);
    left: 0;
    bottom: 0;
    z-index: 9;
    width: 50%;
    overflow-y: auto;
    overflow-x: hidden;
    border-right: 1px solid var(--clr-lines);
    background-color: var(--clr-bg);
    transform: translate3d(-100%, 0, 0);
    visibility: hidden;
    pointer-events: none;
    transition:
      transform 250ms ease-out,
      visibility 250ms ease-out;
  }

  .info-show {
    transform: translate3d(0, 0, 0);
    visibility: visible;
    pointer-events: auto;
  }

  .info h3 {
    display: block;
    margin-block: 0;
    padding: var(--section-padding-top) var(--spacer);
    color: var(--clr-text-light);
    font-size: inherit;
    font-weight: 500;
    border-top: 1px solid var(--clr-lines);
    border-bottom: 1px solid var(--clr-lines);
  }

  .info-about {
    padding: var(--section-padding-top) var(--spacer) 1rem;
    font-size: 1.2rem;
    font-weight: 300;
    line-height: 1.28;
  }

  .info-about p + p {
    margin-top: 1em;
  }

  .info-about-text {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(9rem, 16vw, 13rem);
    gap: 0 calc(var(--spacer) * 3);
    align-items: start;
  }

  :global(.info-avatar) {
    display: block;
    grid-column: 2;
    grid-row: 1 / span 3;
    width: calc(100% - var(--spacer));
    aspect-ratio: 1;
    object-fit: cover;
    margin-right: var(--spacer);
  }

  .info-wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: start;
  }

  .info-contact {
    position: sticky;
    top: -1px;
    padding: var(--section-padding-top) var(--spacer) var(--spacer);
    border-top: 1px solid var(--clr-lines);
  }

  .info-contact address {
    margin-bottom: 1em;
  }

  .info-cv {
    padding-bottom: 1.5em;
    border-left: 1px solid var(--clr-lines);
  }

  .info-cv p {
    max-width: 360px;
    margin: 1em var(--spacer) 0;
  }

  .info-cv li {
    position: relative;
    padding-left: 1.25em;
  }

  .info-cv li::before {
    content: "↦";
    position: absolute;
    left: var(--spacer);
  }

  .info-cv li p {
    margin-block: 0;
  }

  .info-cv ul:has(+ h3),
  .info-cv ul:last-child {
    margin-bottom: 1.5em;
  }

  @media (max-width: 720px) {
    .info {
      width: 100%;
      max-width: 100%;
      border-right: 0;
    }

    .info-about {
      padding: 0.55rem 0.5rem 0.55rem var(--spacer);
    }

    .info-about-text {
      display: block;
      font-size: 1.05rem;
    }

    .info-about p + p {
      clear: both;
    }

    :global(.info-avatar) {
      grid-column: auto;
      grid-row: auto;
      float: right;
      width: clamp(calc(5rem - 2px), calc(22vw - 2px), calc(6.5rem - 2px));
      margin-left: calc(var(--spacer) * 2);
      margin-right: 0;
    }

    .info-wrapper {
      grid-template-columns: 1fr;
    }

    .info-wrapper .info-contact {
      position: relative;
      padding: 0.55rem 0.5rem 0.55rem;
    }

    .info-wrapper .info-cv {
      border-left: 0;
      padding-bottom: 0.75em;
    }

    .info-wrapper h3 {
      padding: 0.55rem 0.5rem;
    }

    .info-wrapper .info-cv p {
      margin: 0.65em 0.5rem 0;
    }

    .info-wrapper .info-cv li::before {
      left: 0.5rem;
    }
  }
</style>
