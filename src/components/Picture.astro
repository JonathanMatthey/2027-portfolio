---
interface Props {
  src: string;
  alt: string;
  class?: string;
  loading?: "lazy" | "eager" | null;
}

const { src, alt, class: className, loading = "lazy" } = Astro.props;
const avifSrc = src.replace(/\.(webp|jpe?g|png)$/i, ".avif");
---

<picture class="picture">
  <source srcset={avifSrc} type="image/avif" />
  <img class={className} src={src} alt={alt} loading={loading ?? undefined} decoding="async" />
</picture>

<style>
  .picture {
    display: contents;
  }

  .picture source {
    display: none;
  }
</style>
