---
import InfoPanel from "./InfoPanel.astro";

interface Props {
  fixed?: boolean;
  heading?: boolean;
}

const { fixed = false, heading = true } = Astro.props;
const Tag = heading ? "h1" : "div";
---

<header class:list={["header", fixed && "header-fixed"]}>
  <Tag class="title">
    <a href="/">Jonathan Matthey</a>
  </Tag>

  <button class="menu" type="button" aria-expanded="false" aria-controls="info-panel">
    info
  </button>

  <InfoPanel />
</header>

<style>
  .header {
    position: relative;
    align-self: start;
    z-index: 10;
    display: grid;
    grid-template-columns: var(--project-row-columns);
    width: 100%;
    background-color: var(--clr-bg);
  }

  .header-fixed {
    position: fixed;
    width: 50%;
  }

  .header::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 1px;
    background-color: var(--clr-lines);
    pointer-events: none;
  }

  .title {
    grid-column: 1 / 3;
    padding: var(--site-header-padding);
    font-size: var(--site-heading-size);
    font-weight: 400;
    line-height: var(--font-size-l-lh);
    text-wrap: balance;
  }

  .title a {
    text-decoration: none;
  }

  .title a:hover {
    background-color: transparent;
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .menu {
    position: relative;
    grid-column: 3 / 4;
    margin-left: var(--spacer);
    padding: var(--site-header-padding);
    font-size: var(--site-heading-size);
    font-weight: 400;
    line-height: var(--font-size-l-lh);
    text-align: center;
    color: var(--clr-lines);
    border-left: 1px solid var(--clr-lines);
  }

  .menu:hover {
    color: var(--clr-bg);
    background-color: var(--clr-lines);
  }

  .menu-close::after {
    content: "←";
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: var(--site-header-padding);
    color: var(--clr-bg);
    background-color: var(--clr-lines);
  }

  @media (max-width: 720px) {
    .header-fixed {
      position: sticky;
      top: 0;
      width: 100%;
    }
  }
</style>
