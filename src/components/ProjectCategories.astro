---
interface Props {
  categories: string[];
}

const { categories } = Astro.props;
---

<ul class="project-categories">
  {categories.map((category) => <li class="project-category">{category}</li>)}
</ul>

<style>
  .project-category {
    display: inline;
    font-size: 0.85rem;
    font-weight: 300;
  }

  .project-category:not(:last-child)::after {
    content: ", ";
    white-space: pre-wrap;
  }

  @media (max-width: 720px) {
    .project-category {
      font-size: 0.7rem;
    }
  }
</style>
