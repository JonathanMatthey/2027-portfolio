---
import Layout from "../layouts/Layout.astro";
import InfoMenu from "../components/InfoMenu.astro";
import Picture from "../components/Picture.astro";
import ProjectCategories from "../components/ProjectCategories.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { projects } from "../data/projects";
import "../styles/home-page.css";

const experimentsAfterIndex = projects.findIndex((project) => project.slug === "artists-in-studio");
const getStackIndex = (index: number) =>
  experimentsAfterIndex >= 0 && index > experimentsAfterIndex ? index + 1 : index;
---

<Layout title="Jonathan Matthey">
  <main class="grid">
    <SiteHeader fixed />

    {
      projects.map((project, index) => (
        <>
          <section
            class="project-infos sticky"
            id={project.slug}
            style={`--stack-index: ${getStackIndex(index)}`}
          >
            <a class="project-row-link" href={`/${project.slug}`} aria-label={`Open ${project.title}`}></a>
            <div class="project-year">{project.year}</div>
            <h2 class="project-title">
              <a href={`/${project.slug}`}>
                {project.shortTitle ? (
                  <>
                    <span class="project-title-full">{project.title}</span>
                    <span class="project-title-short">
                      {project.shortTitle} {project.year}
                    </span>
                  </>
                ) : (
                  project.title
                )}
              </a>
            </h2>
            <ProjectCategories categories={project.categories} />
          </section>

          <a
            class:list={["project-image-wrapper", index === projects.length - 1 && "project-image-last"]}
            href={`/${project.slug}`}
            aria-label={project.title}
            data-project-image={project.slug}
          >
            <Picture
              class="project-image"
              src={project.homepageImage ?? project.image}
              alt={project.alt}
              loading={index < 3 ? "eager" : "lazy"}
            />
          </a>

          {project.slug === "artists-in-studio" && (
            <>
              <section
                class="project-divider sticky"
                style={`--stack-index: ${getStackIndex(index) + 1}`}
                aria-label="Experiments section"
              >
                <div></div>
                <h2>EXPERIMENTS</h2>
                <div></div>
              </section>
              <div class="project-divider-spacer" aria-hidden="true"></div>
            </>
          )}
        </>
      ))
    }

    <footer class="footer">
      <section class="contact">
        <p class="contact-copyright">© jonathan matthey 2026</p>
        <div class="contact-links">
          <a class="contact-link" href="mailto:studio@jonathanmatthey.com">studio@jonathanmatthey.com</a>
          <a class="contact-link" href="https://instagram.com/jonmcut" target="_blank" rel="noreferrer">instagram</a>
        </div>
      </section>
    </footer>
  </main>

  <InfoMenu />

  <script>
    const projectInfos = document.querySelectorAll<HTMLElement>(".project-infos");
    const projectImages = document.querySelectorAll<HTMLImageElement>(".project-image");

    projectImages.forEach((image) => {
      const markLoaded = () => image.classList.add("project-image-loaded");

      if (image.complete && image.naturalWidth > 0) {
        markLoaded();
      } else {
        image.addEventListener("load", markLoaded, { once: true });
      }
    });

    projectInfos.forEach((projectInfo, index) => {
      const image = projectImages[index];

      projectInfo.addEventListener("mouseenter", () => {
        projectInfo.classList.add("project-title-hover");
        image?.classList.add("project-image-hover");
      });

      projectInfo.addEventListener("mouseleave", () => {
        projectInfo.classList.remove("project-title-hover");
        image?.classList.remove("project-image-hover");
      });
    });
  </script>
</Layout>
