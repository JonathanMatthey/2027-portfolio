---
import Layout from "../layouts/Layout.astro";
import InfoMenu from "../components/InfoMenu.astro";
import Picture from "../components/Picture.astro";
import ProjectCategories from "../components/ProjectCategories.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { projects } from "../data/projects";

const experimentsAfterIndex = projects.findIndex((project) => project.slug === "artists-in-studio");
const getStackIndex = (index: number) =>
  experimentsAfterIndex >= 0 && index > experimentsAfterIndex ? index + 1 : index;
---

<Layout title="Jonathan Matthey">
  <main class="grid">
    <SiteHeader fixed />

    {
      projects.map((project, index) => (
        <>
          <section
            class="project-infos sticky"
            id={project.slug}
            style={`--stack-index: ${getStackIndex(index)}`}
          >
            <a class="project-row-link" href={`/${project.slug}`} aria-label={`Open ${project.title}`}></a>
            <div class="project-year">{project.year}</div>
            <h2 class="project-title">
              <a href={`/${project.slug}`}>
                {project.shortTitle ? (
                  <>
                    <span class="project-title-full">{project.title}</span>
                    <span class="project-title-short">
                      {project.shortTitle} {project.year}
                    </span>
                  </>
                ) : (
                  project.title
                )}
              </a>
            </h2>
            <ProjectCategories categories={project.categories} />
          </section>

          <a
            class:list={["project-image-wrapper", index === projects.length - 1 && "project-image-last"]}
            href={`/${project.slug}`}
            aria-label={project.title}
            data-project-image={project.slug}
          >
            <Picture class="project-image" src={project.homepageImage ?? project.image} alt={project.alt} />
          </a>

          {project.slug === "artists-in-studio" && (
            <>
              <section
                class="project-divider sticky"
                style={`--stack-index: ${getStackIndex(index) + 1}`}
                aria-label="Experiments section"
              >
                <div></div>
                <h2>EXPERIMENTS</h2>
                <div></div>
              </section>
              <div class="project-divider-spacer" aria-hidden="true"></div>
            </>
          )}
        </>
      ))
    }

    <footer class="footer">
      <section class="contact">
        <p class="contact-copyright">© jonathan matthey 2026</p>
        <div class="contact-links">
          <a class="contact-link" href="mailto:studio@jonathanmatthey.com">studio@jonathanmatthey.com</a>
          <a class="contact-link" href="https://instagram.com/jonmcut" target="_blank" rel="noreferrer">instagram</a>
        </div>
      </section>
    </footer>
  </main>

  <InfoMenu />

  <script>
    const projectInfos = document.querySelectorAll<HTMLElement>(".project-infos");
    const projectImages = document.querySelectorAll<HTMLImageElement>(".project-image");

    projectInfos.forEach((projectInfo, index) => {
      const image = projectImages[index];

      projectInfo.addEventListener("mouseenter", () => {
        projectInfo.classList.add("project-title-hover");
        image?.classList.add("project-image-hover");
      });

      projectInfo.addEventListener("mouseleave", () => {
        projectInfo.classList.remove("project-title-hover");
        image?.classList.remove("project-image-hover");
      });
    });
  </script>
</Layout>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    max-width: 100vw;
    min-height: 100vh;
  }

  .project-title a {
    text-decoration: none;
  }

  .project-title a:hover {
    background-color: transparent;
    text-decoration: underline;
  }

  .project-infos {
    grid-column: 1 / 2;
    display: grid;
    grid-template-columns: var(--project-row-columns);
    align-items: start;
    position: relative;
    background-color: var(--clr-bg);
    transition: background-color 180ms ease-out;
  }

  .project-infos:hover,
  .project-infos.project-title-hover {
    background-color: var(--clr-bg-hover);
  }

  .project-row-link {
    position: absolute;
    inset: 0;
    z-index: 1;
    text-decoration: none;
  }

  .project-row-link:hover {
    background-color: transparent;
  }

  .project-infos:hover .project-title a {
    text-decoration: underline;
  }

  :global(.header) + .project-infos {
    margin-top: calc(var(--header-height, 49px) - 1px);
  }

  :global(.header) + .project-infos > * {
    border-top: none;
  }

  :global(.header) + .project-infos > :global(.project-categories) {
    border-top: none;
  }

  .sticky {
    position: sticky;
    top: calc(
      var(--header-height, 49px) - 1px +
      (var(--stack-index, 0) * var(--project-stack-offset, 57px))
    );
  }

  .project-year {
    grid-column: 1 / 2;
    position: relative;
    z-index: 2;
    pointer-events: none;
    padding: var(--section-padding-top) var(--spacer) var(--project-row-padding-bottom);
    font-size: 0.85rem;
    font-weight: 300;
    border-top: 1px solid var(--clr-lines);
  }

  .project-title {
    grid-column: 2 / 3;
    position: relative;
    z-index: 2;
    pointer-events: none;
    overflow: hidden;
    padding: var(--section-padding-top) 0 var(--project-row-padding-bottom) var(--spacer);
    font-size: var(--site-heading-size);
    font-weight: 400;
    line-height: var(--font-size-l-lh);
    text-overflow: ellipsis;
    text-wrap: balance;
    border-top: 1px solid var(--clr-lines);
    transition: color 180ms ease-out, padding 75ms ease-in-out;
  }

  .project-title a {
    font-weight: inherit;
    pointer-events: auto;
    transition: color 180ms ease-out;
  }

  .project-title-hover {
    cursor: pointer;
  }

  .project-title-short {
    display: none;
  }

  :global(.project-categories) {
    grid-column: 3 / 4;
    position: relative;
    z-index: 2;
    pointer-events: none;
    padding: var(--section-padding-top) var(--spacer) var(--project-row-padding-bottom);
    border-top: 1px solid var(--clr-lines);
    transition: color 180ms ease-out;
  }

  .project-divider {
    grid-column: 1 / 2;
    display: grid;
    grid-template-columns: var(--project-row-columns);
    align-items: start;
    background-color: var(--clr-bg);
  }

  .project-divider > * {
    padding: var(--section-padding-top) var(--spacer) var(--project-row-padding-bottom);
    border-top: 1px solid var(--clr-lines);
  }

  .project-divider h2 {
    font-size: var(--site-heading-size);
    font-weight: 400;
    line-height: var(--font-size-l-lh);
  }

  .project-divider-spacer {
    grid-column: 2 / 3;
    align-self: start;
    position: sticky;
    top: 0;
    z-index: 2;
    min-height: 25vh;
    background-color: var(--clr-bg);
  }

  .project-image-wrapper {
    grid-column: 2 / 3;
    align-self: start;
    position: sticky;
    top: 0;
    z-index: 2;
    display: grid;
    max-height: 100vh;
    overflow: hidden;
  }

  .project-image-wrapper:hover {
    background-color: transparent;
  }

  .project-image-last {
    align-content: start;
    min-height: 100vh;
    background-color: var(--clr-bg);
  }

  .project-image-last:hover {
    background-color: var(--clr-bg);
  }

  .project-image {
    max-height: 100vh;
    justify-self: center;
    transition: transform 240ms ease-out;
  }

  .project-image-hover {
    transform: scale(1.025);
  }

  .footer {
    position: sticky;
    top: 0;
    z-index: 1;
    min-height: 100vh;
    background-color: var(--clr-bg);
  }

  .contact {
    position: sticky;
    top: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1em;
    padding: var(--section-padding-top) var(--spacer) var(--spacer);
    border-top: 1px solid var(--clr-lines);
  }

  .contact-copyright {
    margin: 0;
  }

  .contact-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .contact-link {
    margin: 0;
    text-decoration: underline;
  }

  .contact-link:hover {
    background-color: transparent;
  }

  @media (max-width: 720px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .sticky {
      position: static;
    }

    .project-infos,
    .project-image-wrapper,
    .project-divider,
    .project-divider-spacer {
      grid-column: span 1;
      z-index: 0;
    }

    .project-image-wrapper,
    .project-divider-spacer,
    .footer,
    .contact {
      position: static;
    }

    .project-image-last,
    .footer {
      min-height: 0;
    }

    .project-divider-spacer {
      min-height: 0;
    }

    :global(.header) + .project-infos {
      margin-top: 0;
    }

    .project-infos {
      grid-template-columns: 1.35fr 4.65fr 2fr;
    }

    .project-row-link {
      display: none;
    }

    .project-infos.sticky > * {
      border-top: none;
    }

    .project-infos.sticky > :global(.project-categories) {
      border-top: none;
    }

    .project-year,
    .project-title {
      padding-top: 0.5rem;
      padding-bottom: 0.5rem;
    }

    :global(.project-categories) {
      padding-top: 0.5rem;
      padding-bottom: 0.5rem;
    }

    .project-year {
      font-size: 0.7rem;
      align-self: center;
    }

    .project-title {
      font-size: 1.6rem;
      padding-top: calc(0.5rem + 1px);
    }

    .project-title-full {
      display: none;
    }

    .project-title-short {
      display: inline;
    }
  }
</style>
