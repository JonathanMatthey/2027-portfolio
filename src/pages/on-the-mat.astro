---
import ProjectPage from "../layouts/ProjectPage.astro";
import ProjectGallery from "../components/ProjectGallery.astro";
import { getProject } from "../data/projects";
import { projectGalleryBySlug } from "../data/project-pages";

const project = getProject("on-the-mat");
---

<ProjectPage project={project}>
  <ProjectGallery images={projectGalleryBySlug["on-the-mat"]} alt={`${project.title} documentation`} />
</ProjectPage>
